# Core
DATABASE_URL=""
JWT_SECRET=""
PORT=3000

# Base URL the invitation links point at. Defaults to http://localhost:5173.
CLIENT_URL="http://localhost:5173"

# Outgoing mail. Without these, invitation and verification emails fail and the
# reason is recorded in email_delivery_logs.error_message.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Prisma seed (npm run db:seed). All four passwords are required, and the seed
# refuses to run unless SEED_ALLOW is exactly "true". It never runs when
# NODE_ENV=production.
STUDENT_PASSWORD=""
ADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_STUDENT_PASSWORD=""
SEED_ALLOW="false"
